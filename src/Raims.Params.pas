function TUpdatePaymentLinkParams.SetPaymentMethodTypes(const Value: TArray<Int64>): TUpdatePaymentLinkParams;
var
  Values: TJSONArray;
  Index: Integer;
begin
  Values := TJSONArray.Create;
  try
    for Index := 0 to Length(Value) - 1 do
      Values.AddElement(TJSONNumber.Create(Value[Index]));
    SetJson('payment_method_types', Values);
  finally
    Values.Free;
  end;
  Result := Self;
end;

function TUpdatePaymentLinkParams.SetPaymentMethodTypesNull: TUpdatePaymentLinkParams;
begin
  SetNull('payment_method_types');
  Result := Self;
end;

function TUpdatePaymentLinkParams.UnsetPaymentMethodTypes: TUpdatePaymentLinkParams;
begin
  Unset('payment_method_types');
  Result := Self;
end;

