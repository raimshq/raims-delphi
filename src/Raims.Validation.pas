procedure RaimsValidateResponse(const OperationId: string; const Response: TRaimsResponse);
var
  Data: TJSONObject;
begin
  if Response.Metadata.StatusCode = 204 then
  begin
    if Response.Body <> '' then InvalidResponse;
    Exit;
  end;
  Data := RaimsParseObject(Response.Body);
  try
    try
      if OperationId = 'GetCharge' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaCharge(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'UpdateCharge' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaCharge(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'RevokeCharge' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaChargeRevoked(Data);
          202: ValidateSchemaChargeRevocationPending(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'ListCharges' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaChargeListResponse(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'CreateCharge' then
      begin
        case Response.Metadata.StatusCode of
          201: ValidateSchemaChargeCreated(Data);
          202: ValidateSchemaChargeCreated(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'CreateCustomer' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaCustomerCreated(Data);
          201: ValidateSchemaCustomerCreated(Data);
        else
          InvalidResponse;
        end;
      end
      else if OperationId = 'ListCustomers' then
      begin
        case Response.Metadata.StatusCode of
          200: ValidateSchemaCustomerListResponse(Data);
        else
          InvalidResponse;
        end;
      end
